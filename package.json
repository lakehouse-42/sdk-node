{
  "name": "@lakehouse42/sdk",
  "version": "1.0.0",
  "description": "Official Node.js/TypeScript SDK for the Lakehouse42 API",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "lakehouse42",
    "rag",
    "search",
    "vector-search",
    "hybrid-search",
    "knowledge-graph",
    "ai",
    "llm",
    "typescript",
    "sdk"
  ],
  "author": "Lakehouse42 Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lakehouse-42/lakehouse42-sdk"
  },
  "homepage": "https://docs.lakehouse42.com/sdk/node",
  "bugs": {
    "url": "https://github.com/lakehouse-42/lakehouse42-sdk/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "ws": "^8.14.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.10",
    "@eslint/js": "^9.39.2",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vitest/coverage-v8": "^1.0.0",
    "eslint": "^8.55.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.53.1",
    "vitest": "^1.0.0"
  },
  "sideEffects": false
}
